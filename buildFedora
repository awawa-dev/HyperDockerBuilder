ARG DOCKER_SOURCE
FROM ${DOCKER_SOURCE}

# install the packages required by HyperHDR

RUN sudo dnf -y upgrade
RUN sudo dnf -y install \
    alsa-lib-devel \
    chrpath \
    cmake \
    dbus-devel \
    fedora-packager \
    flatbuffers-compiler \
    flatbuffers-devel \
    gcc \
    gcc-c++ \
    git \
    libftdi-c++-devel \
    libglvnd-devel \
    libusb1-devel \
    libzstd-devel \
    lld \    
    mesa-libEGL-devel \
    mesa-libGL-devel \
    ninja-build \
    openssl-devel \
    pipewire-devel \
    pkg-config \
    turbojpeg-devel \
    unzip \
    wget \
    xz-devel

RUN sudo dnf clean all

RUN mkdir -p /scripts
COPY build.sh /scripts
WORKDIR /scripts
RUN chmod +x build.sh
RUN ./build.sh

