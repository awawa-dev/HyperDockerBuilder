ARG DOCKER_SOURCE
FROM ${DOCKER_SOURCE}

# install the packages required by HyperHDR
ARG DOCKER_SOURCE
RUN bash -c ' \
    if [[ "${DOCKER_SOURCE}" == *bullseye* ]]; then \
        echo "Switch Debian Bullseye (EOL) to archive and synchronize..."; \
        echo "deb http://archive.debian.org/debian bullseye main" > /etc/apt/sources.list; \
        echo "Acquire::Check-Valid-Until \"false\";" > /etc/apt/apt.conf.d/99no-check-valid-until; \
        echo -e "Package: *\nPin: origin \"archive.debian.org\"\nPin-Priority: 1001" > /etc/apt/preferences.d/99downgrade; \
        apt-get update && apt-get dist-upgrade -y --allow-downgrades; \
    fi; \
    if [[ "${DOCKER_SOURCE}" == arm64* ]] || [[ "${DOCKER_SOURCE}" == arm32* ]]; then \
        apt-get update && apt-get install -y --no-install-recommends curl gnupg ca-certificates; \
        update-ca-certificates; \
        . /etc/os-release; \
        curl -fsSL "https://github.com/raspberrypi/rpi-image-gen/raw/master/keydir/raspberrypi-archive-keyring.gpg" | gpg --dearmor -o /usr/share/keyrings/raspberrypi-archive-keyring.gpg; \
        echo "deb [signed-by=/usr/share/keyrings/raspberrypi-archive-keyring.gpg] http://archive.raspberrypi.com/debian/ ${VERSION_CODENAME} main" > /etc/apt/sources.list.d/raspberrypi.list; \
        apt-get update; \
        (apt-get install -y --no-install-recommends libcec-dev libp8-platform-dev raspi-utils-dt raspi-utils-core libdtovl0 libdrm-dev || true); \
        (apt-get install -y --no-install-recommends mesa-vulkan-drivers || true); \
        rm -rf /etc/apt/sources.list.d/raspberrypi.list; \
        apt-get update; \
    else \
        apt-get update && (apt-get install -y libcec-dev libp8-platform-dev || true); \
        echo "Skipping Raspberry Pi OS repository, docker source is ${DOCKER_SOURCE}"; \
    fi;'

# install the packages required by HyperHDR
RUN apt-get install -y \
    build-essential \
    cmake \
    flatbuffers-compiler \
    git \
    libasound2-dev \
    libayatana-appindicator3-dev \
    libegl-dev \
    libflatbuffers-dev \
    libftdi1-dev \
    libgl-dev \
    libglvnd-dev \
    libgtk-3-dev \
    liblzma-dev \
    libpipewire-0.3-dev \
    libssl-dev \
    libsystemd-dev \
    libturbojpeg0-dev \
    libudev-dev \
    libusb-1.0-0-dev \
    libx11-dev \
    libzstd-dev \
    lld \
    ninja-build \
    patchelf \
    pkg-config \
    python3 \
    unzip \
    wget

RUN bash -c 'if [[ "${DOCKER_SOURCE}" == *bullseye* ]]; then \
        echo "Updating cmake..."; \
        apt-get remove -y cmake cmake-data; \
        apt-get install -y python3-pip; \
        pip3 install cmake --upgrade; \
    fi;'

RUN mkdir -p /scripts
COPY build.sh /scripts
WORKDIR /scripts
RUN chmod +x /scripts/build.sh
RUN /scripts/build.sh

